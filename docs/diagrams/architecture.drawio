rounded=0;html=1;strokeColor=#586574;strokeWidth=1.7;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="907" y="1679" /><mxPoint x="907" y="965" /></Array></mxGeometry></mxCell><mxCell id="edge-19" parent="1" source="selection" target="result" value="Find passages: no generation" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586574;strokeWidth=1.7;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;entryX=1.0;entryY=0.5;dashed=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1360" y="1203" /><mxPoint x="1360" y="1917" /></Array></mxGeometry></mxCell><mxCell id="edge-20" parent="1" source="source-view" target="originals" value="Exact-version original" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586574;strokeWidth=1.7;endArrow=block;endFill=1;exitX=0.0;exitY=0.5;entryX=0.0;entryY=0.5;dashed=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="45" y="2155" /><mxPoint x="45" y="1203" /></Array></mxGeometry></mxCell><mxCell id="note-0" parent="1" value="SQL policies, leased jobs, chunks, audit and usage share the existing application database; there is no vector database or Azure AI Search tier." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#526276;" vertex="1"><mxGeometry x="54" y="2524" width="1292" height="24" as="geometry" /></mxCell><mxCell id="note-1" parent="1" value="The index timer runs in the API host. There is no dedicated RAG/OCR container or Service Bus indexing queue." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#526276;" vertex="1"><mxGeometry x="54" y="2547" width="1292" height="24" as="geometry" /></mxCell><mxCell id="note-2" parent="1" value="AI access uses managed identity and connectivity-Hub private endpoints/DNS. Routine RAG audit avoids raw prompts and document text." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#526276;" vertex="1"><mxGeometry x="54" y="2570" width="1292" height="24" as="geometry" /></mxCell><mxCell id="note-3" parent="1" value="Architecture, not a live health check: feature flags and source permissions control execution. Python examples model the core flow locally." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#526276;" vertex="1"><mxGeometry x="54" y="2593" width="1292" height="24" as="geometry" /></mxCell><mxCell id="note-4" parent="1" value="Purpose icons follow the established portfolio design. No private resource names, account identifiers or document contents are shown." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#526276;" vertex="1"><mxGeometry x="54" y="2616" width="1292" height="24" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
